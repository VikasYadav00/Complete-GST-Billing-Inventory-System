# RetailPro Backend Environment Variables
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retailpro?schema=public

# Authentication Secrets
JWT_ACCESS_SECRET=retailpro_super_secret_access_jwt_key_2026_xyz
JWT_REFRESH_SECRET=retailpro_super_secret_refresh_jwt_key_2026_xyz
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# Cloudinary Integration (Image Storage)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo

# WhatsApp Business Platform Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=retailpro_webhook_secret_token_2026
WHATSAPP_WEBHOOK_APP_SECRET=retailpro_meta_app_secret_2026

# General Configuration
DEFAULT_BUSINESS_NAME="RetailPro Supermart"
LOG_LEVEL=info
